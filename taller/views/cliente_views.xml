<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_cliente_list" model="ir.ui.view">
        <field name="name">taller.cliente.list</field>
        <field name="model">taller.cliente</field>
         <field name="arch" type="xml">
             <tree>
                 <field name="nombre"/>
                 <field name="email"/>
                 <field name="telefono"/>
             </tree>
         </field>
    </record>

    <record id="view_cliente_form" model="ir.ui.view">
        <field name="name">taller.cliente.form</field>
        <field name="model">taller.cliente</field>
         <field name="arch" type="xml">
             <form>
                 <sheet>
                     <group>
                         <field name="nombre"/>
                         <field name="email"/>
                         <field name="telefono"/>
                         <field name="activo"/>
                     </group>
                 </sheet>
             </form>
         </field>
    </record>

    <record id="action_clientes" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">taller.cliente</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_taller_root" name="TallerMecanico" sequence="10"/>
    <menuitem id="menu_clientes" name="Clientes" parent="menu_taller_root" action="action_clientes"/>
</odoo>