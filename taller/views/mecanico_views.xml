<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mecanico_list" model="ir.ui.view">
        <field name="name">taller.mecanico.list</field>
        <field name="model">taller.mecanico</field>
         <field name="arch" type="xml">
             <tree>
                 <field name="nombre"/>
                 <field name="especialidad"/>
                 <field name="telefono"/>
             </tree>
         </field>
    </record>

    <record id="view_mecanico_form" model="ir.ui.view">
        <field name="name">taller.mecanico.form</field>
        <field name="model">taller.mecanico</field>
         <field name="arch" type="xml">
             <form>
                 <sheet>
                     <group>
                         <field name="nombre"/>
                         <field name="especialidad"/>
                         <field name="telefono"/>
                         <field name="activo"/>
                     </group>
                 </sheet>
             </form>
         </field>
    </record>

    <record id="action_mecanicos" model="ir.actions.act_window">
        <field name="name">Mecanicos</field>
        <field name="res_model">taller.mecanico</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_mecanicos" name="Mecanicos" parent="menu_taller_root" action="action_mecanicos"/>
</odoo>